type organization_kind (club, regional_association, federation, other)
type person_sex (not_known, male, female, non_binary, not_applicable)
type competition_status (planned, open, running, completed, aborted, canceled)
type competition_entry_status (registered, withdrawn, present, started, completed, disqualified, canceled)
type participant_member_role (leader, follower, solo_dancer, duo_member, formation_member, small_group_member)
type competition_round_kind (general_look, preliminary, intermediate, final, placement, tie_breaker)
type competition_round_status (planned, drawn, running, completed, canceled)


org.organizations
  id uuid pk
  kind organization_kind
  name varchar
  code varchar
  short_name varchar
  note text

org.organization_external_ids
  id uuid pk
  organization_id uuid -> org.organizations(id)
  source_system varchar
  external_id varchar
  note text

org.federations
  id uuid pk
  organization_id uuid -> org.organizations(id)


people.persons
  id uuid pk
  title varchar
  given_name varchar
  surname_prefix varchar
  surname varchar
  display_name varchar
  sex person_sex
  nationality_code char(2)


catalog.flooring_types
  id uuid pk
  federation_id uuid -> org.federations(id)
  name varchar
  code varchar

catalog.competition_types
  id uuid pk
  federation_id uuid -> org.federations(id)
  name varchar
  code varchar
  note text

catalog.competition_disciplines
  id uuid pk
  federation_id uuid -> org.federations(id)
  name varchar
  code varchar
  note text

catalog.competition_forms
  id uuid pk
  federation_id uuid -> org.federations(id)
  name varchar
  code varchar
  note text

catalog.competition_orders
  id uuid pk
  federation_id uuid -> org.federations(id)
  name varchar
  code varchar
  note text

catalog.participant_types
  id uuid pk
  federation_id uuid -> org.federations(id)
  name varchar
  code varchar
  note text

catalog.age_groups
  id uuid pk
  federation_id uuid -> org.federations(id)
  name varchar
  code varchar
  min_age int
  max_age int
  note text

catalog.start_classes
  id uuid pk
  federation_id uuid -> org.federations(id)
  name varchar
  code varchar
  sort_order int
  note text

catalog.leagues
  id uuid pk
  federation_id uuid -> org.federations(id)
  name varchar
  code varchar
  competition_year int
  note text

catalog.dances
  id uuid pk
  federation_id uuid -> org.federations(id)
  competition_discipline_id uuid -> catalog.competition_disciplines(id)
  name varchar
  code varchar
  note text


venue.tournaments
  id uuid pk
  federation_id uuid -> org.federations(id)
  name varchar
  start_date date
  end_date date
  host_organization_id uuid -> org.organizations(id)
  organizer_organization_id uuid -> org.organizations(id)
  note text

venue.tournament_external_ids
  id uuid pk
  tournament_id uuid -> venue.tournaments(id)
  source_system varchar
  external_id varchar
  note text

venue.halls
  id uuid pk
  tournament_id uuid -> venue.tournaments(id)
  name varchar
  abbreviation varchar
  note text

venue.floors
  id uuid pk
  tournament_id uuid -> venue.tournaments(id)
  hall_id uuid -> venue.halls(id)
  name varchar
  abbreviation varchar
  length_in_meters decimal(8,2)
  width_in_meters decimal(8,2)
  flooring_type_id uuid -> catalog.flooring_types(id)
  note text


people.participants
  id uuid pk
  participant_type_id uuid -> catalog.participant_types(id)
  display_name varchar
  note text

people.participant_external_ids
  id uuid pk
  participant_id uuid -> people.participants(id)
  source_system varchar
  external_id varchar
  note text

people.participant_members
  id uuid pk
  participant_id uuid -> people.participants(id)
  person_id uuid -> people.persons(id)
  member_no int
  member_role participant_member_role
  organization_id uuid -> org.organizations(id)
  is_primary_number_carrier boolean


competition.competitions
  id uuid pk
  tournament_id uuid -> venue.tournaments(id)
  name varchar
  planned_start_at timestamptz
  default_floor_id uuid -> venue.floors(id)
  status competition_status
  competition_type_id uuid -> catalog.competition_types(id)
  competition_discipline_id uuid -> catalog.competition_disciplines(id)
  competition_form_id uuid -> catalog.competition_forms(id)
  competition_order_id uuid -> catalog.competition_orders(id)
  participant_type_id uuid -> catalog.participant_types(id)
  age_group_id uuid -> catalog.age_groups(id)
  start_class_id uuid -> catalog.start_classes(id)
  league_id uuid -> catalog.leagues(id)
  note text

competition.competition_external_ids
  id uuid pk
  competition_id uuid -> competition.competitions(id)
  source_system varchar
  external_id varchar
  note text

competition.competition_dances
  id uuid pk
  competition_id uuid -> competition.competitions(id)
  dance_id uuid -> catalog.dances(id)
  sequence_no int
  note text

competition.competition_judges
  id uuid pk
  competition_id uuid -> competition.competitions(id)
  person_id uuid -> people.persons(id)
  panel_letter varchar
  note text


participation.competition_entries
  id uuid pk
  competition_id uuid -> competition.competitions(id)
  participant_id uuid -> people.participants(id)
  start_number int
  status competition_entry_status
  registered_at_utc timestamptz
  checked_in_at_utc timestamptz
  withdrawn_at_utc timestamptz
  withdrawal_reason varchar
  disqualified_at_utc timestamptz
  disqualification_reason varchar
  note text


competition.competition_rounds
  id uuid pk
  competition_id uuid -> competition.competitions(id)
  number int
  kind competition_round_kind
  status competition_round_status
  name varchar
  floor_id uuid -> venue.floors(id)
  planned_start_at timestamptz
  started_at_utc timestamptz
  completed_at_utc timestamptz
  note text

competition.competition_round_judges
  id uuid pk
  round_id uuid -> competition.competition_rounds(id)
  competition_judge_id uuid -> competition.competition_judges(id)
  position_code varchar
  draw_order int
  note text


participation.competition_round_results
  id uuid pk
  round_id uuid -> competition.competition_rounds(id)
  competition_entry_id uuid -> participation.competition_entries(id)
  next_round_id uuid -> competition.competition_rounds(id)
  rank_from int
  rank_to int
  note text

participation.competition_round_heats
  id uuid pk
  round_id uuid -> competition.competition_rounds(id)
  number int
  dance_id uuid -> catalog.dances(id)
  name varchar
  note text

participation.competition_round_heat_entries
  id uuid pk
  heat_id uuid -> participation.competition_round_heats(id)
  competition_entry_id uuid -> participation.competition_entries(id)
  start_order int

participation.competition_round_heat_results
  id uuid pk
  heat_id uuid -> participation.competition_round_heats(id)
  competition_entry_id uuid -> participation.competition_entries(id)
  rank_from int
  rank_to int
  note text

participation.competition_results
  id uuid pk
  competition_id uuid -> competition.competitions(id)
  competition_entry_id uuid -> participation.competition_entries(id)
  final_rank_from int
  final_rank_to int
  is_finalist boolean
  note text

