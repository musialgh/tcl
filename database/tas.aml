# TAS database model
#
# Current focus:
# - event and competition execution only
# - intentionally small initial core
# - rounds and dance-specific heats are persisted
# - judging marks and calculated result values are persisted for traceability
# - scoring calculation logic itself is intentionally excluded and expected to be
#   handled by the DSL/domain logic
#
# Naming convention:
# - Event = Veranstaltung
# - Competition = Turnier
# - table names are singular
#
# PLEASE NOTE: color property from AML is currently ignored by azimutt! :-(


type organization_kind (club, regional_association, federation, other)
type person_sex (not_known, male, female, non_binary, not_applicable)
type participant_member_role (unspecified, lead, follow)


##### blue: Static configuration data (usually no changes during event) #####


organization {color: blue}
  id uuid pk
  kind organization_kind
  name varchar
  code varchar nullable unique
  short_name varchar nullable
  note text nullable

organization_external_id {color: orange} | Allows one organization to carry multiple identifiers from different external systems such as DTV ESV or DETV.
  id uuid pk
  organization_id uuid unique=organization_external_id_organization_source_uniq -> organization(id)
  source_system varchar unique=organization_external_id_organization_source_uniq unique=organization_external_id_source_external_uniq
  external_id varchar unique=organization_external_id_source_external_uniq
  note text nullable

federation {color: blue} | A federation is also represented as an organization. Display data such as name and code are sourced from organization. Examples: DTV, WDSF.
  id uuid pk
  organization_id uuid unique -> organization(id)

person {color: blue}
  id uuid pk
  title varchar nullable
  given_name varchar
  surname_prefix varchar nullable
  surname varchar
  display_name varchar
  sex person_sex nullable
  nationality_code char(2) nullable

flooring_type {color: blue}
  id uuid pk
  federation_id uuid nullable unique=flooring_type_federation_code_uniq -> federation(id)
  name varchar
  code varchar unique=flooring_type_federation_code_uniq

competition_type {color: blue}
  id uuid pk
  organization_id uuid unique=idx_code -> organization
  name varchar
  code varchar unique=idx_code
  note text nullable

competition_discipline {color: blue}
  id uuid pk
  organization_id uuid unique=idx_code -> organization
  name varchar
  code varchar unique=idx_code
  note text nullable

competition_form {color: blue}
  id uuid pk
  organization_id uuid unique=idx_code -> organization
  name varchar
  code varchar unique=idx_code
  note text nullable

competition_order {color: blue}
  id uuid pk
  organization_id uuid unique=idx_code -> organization
  name varchar
  code varchar unique=idx_code
  note text nullable

participant_type {color: blue} | TBD purpose?
  id uuid pk
  federation_id uuid unique=participant_type_federation_code_uniq -> federation(id)
  name varchar
  code varchar unique=participant_type_federation_code_uniq
  note text nullable

age_group {color: blue}
  id uuid pk
  federation_id uuid unique=age_group_federation_code_uniq -> federation(id)
  name varchar
  code varchar unique=age_group_federation_code_uniq
  min_age int nullable
  max_age int nullable
  note text nullable

start_class {color: blue}
  id uuid pk
  federation_id uuid unique=start_class_federation_code_uniq -> federation(id)
  name varchar
  code varchar unique=start_class_federation_code_uniq
  sort_order int nullable
  note text nullable

league {color: blue}
  id uuid pk
  federation_id uuid unique=league_federation_code_year_uniq -> federation(id)
  name varchar
  code varchar unique=league_federation_code_year_uniq
  competition_year int unique=league_federation_code_year_uniq
  note text nullable

dance {color: blue}
  id uuid pk
  federation_id uuid unique=dance_federation_code_uniq -> federation(id)
  competition_discipline_id uuid nullable -> competition_discipline(id)
  name varchar
  code varchar unique=dance_federation_code_uniq
  note text nullable


#### green: Logical event and competition setup & performance #####


# event setup

event {color: green}
  id uuid pk
  federation_id uuid -> federation(id)
  name varchar
  start_date date
  end_date date
  host_organization_id uuid -> organization(id)
  organizer_organization_id uuid nullable -> organization(id)
  note text nullable | OrganizerOrganizationId is optional. Effective organizer is organizer_organization_id ?? host_organization_id.

event_external_id {color: orange}
  id uuid pk
  event_id uuid unique=event_external_id_event_source_uniq -> event(id)
  source_system varchar unique=event_external_id_event_source_uniq unique=event_external_id_source_external_uniq
  external_id varchar unique=event_external_id_source_external_uniq
  note text nullable

hall {color: green}
  id uuid pk
  event_id uuid unique=hall_event_name_uniq unique=hall_event_abbreviation_uniq -> event(id)
  name varchar unique=hall_event_name_uniq
  abbreviation varchar nullable unique=hall_event_abbreviation_uniq
  note text nullable

floor {color: green} | event_id is intentionally denormalized for uniqueness and simpler references. It must match the event of the referenced hall.
  id uuid pk
  event_id uuid unique=floor_event_abbreviation_uniq -> event(id)
  hall_id uuid -> hall(id)
  name varchar
  abbreviation varchar nullable unique=floor_event_abbreviation_uniq
  length_in_meters decimal(8,2)
  width_in_meters decimal(8,2)
  flooring_type_id uuid nullable -> flooring_type(id)
  note text nullable

# participants

participant {color: green}
  id uuid pk
  event_id uuid -> event
  participant_type_id uuid -> participant_type | TBD purpose?
  status participant_status(registered, withdrawn, present, started, completed, disqualified, canceled)=registered
  organization_id uuid nullable -> organization | only if same for all members (which may be required in federation events)
  startno_id uuid nullable -> startno | maybe mandatory on ESV import, but we may need this flexibility elsewhere
  display_name varchar
  note text nullable

participant_external_id {color: orange}
  id uuid pk
  participant_id uuid unique=participant_external_id_participant_source_uniq -> participant(id)
  source_system varchar unique=participant_external_id_participant_source_uniq unique=participant_external_id_source_external_uniq
  external_id varchar unique=participant_external_id_source_external_uniq
  note text nullable

participant_member {color: green} |||
  member_role is deliberately generic.
  The participant type defines whether a participant is a pair, solo, duo, group, or any future structure.
|||
  id uuid pk
  participant_id uuid unique=participant_member_participant_member_no_uniq unique=participant_member_participant_person_uniq -> participant(id)
  person_id uuid unique=participant_member_participant_person_uniq -> person(id)
  member_no int unique=participant_member_participant_member_no_uniq
  member_role participant_member_role
  organization_id uuid nullable -> organization(id)
  is_primary_number_carrier boolean=false

# competitions

competition {color: green} |||
  A single observable, scheduled contest for a ranking between competing participants. 
  - normally, defined by a single start class and age group 
  - if age classes and/or age groups are combined, *competition* represents the combination 
    (i.e. all participants competing at the same *time*) 
|||
  id uuid pk
  event_id uuid -> event
  name varchar
  status competition_status_type(planned, ready, running, completed, aborted, canceled)=planned
  startno_stack_id    uuid -> competition_startno_stack
  type_id             uuid -> competition_type
  discipline_id       uuid -> competition_discipline
  form_id             uuid -> competition_form
  order_id            uuid -> competition_order
  participant_type_id uuid -> participant_type
  league_id uuid nullable -> league(id) | only used for league competitions
  note text nullable

rel competition <> age_group   | n:m relation between competitions and age groups (m > 1 required for combinations)
rel competition <> start_class | n:m relation between competitions and start classes (m > 1 required for combinations)
rel competition <> floor       | default floor(s) assigned to the competition (to select round-specific floor assignments from)

competition_dance {color: green} |||
  A "default" dance for a competition, defining superset of dances available for each round, and their order.

  Note: This is almost just a join entity, but we also need sequence_no for ordering.
|||
  id uuid pk
  competition_id uuid unique=idx_sequence -> competition
  dance_id uuid -> dance | note: not unique, to support repeated dances in a round (e.g. Jack & Jill)
  sequence_no int unique=idx_sequence
  note text nullable

rel competition_dance <> round | subset of dances selected for each round, using ordering from competition_dance.sequence_no

# start numbers

competition_startno_stack {color: green}
  id uuid pk
  startno_stack_id uuid -> startno_stack
  competition_id uuid unique=idx_purpose -> competition
  purpose participant_member_role unique=idx_purpose 
  min_number int | must be within number range of referenced raw stack
  max_number int | must be within number range of referenced raw stack
  note text nullable

startno_stack {color: green} | a physical or logical "stack" of start numbers to use for one or more purposes
  id uuid pk
  event_id uuid -> event
  name varchar
  min_number int | lowest number (note: missing numbers modeled via start_number objects)
  max_number int | lowest number (note: missing numbers modeled via start_number objects)
  note text

startno {color: green} | a single start number, modeled as entity to easily safeguard against concurrency issues
  id uuid pk
  startno_stack_id uuid -> startno_stack
  number int

# round setup

round {color: green}
  id uuid pk
  competition_id uuid unique=idx_sequence -> competition
  number int=1 unique=idx_sequence
  kind round_kind(general_look, classification, preliminary, redance, intermediate, semifinal, final, placement, tie_breaker)
  status round_status(planned, ready, running, paused, completed, published, canceled)=planned
  name varchar
  note text nullable

rel round <> floor | floor selection for each round, (usually) subset of competition default floors

teamup {color: green} | a judged party, e.g. a couple (one participant) or a temporary Jack & Jill team (two participants), dancing in a heat
  id uuid pk
  round_id uuid -> round
  dance_id uuid -> dance
  heat_number int=1

rel teamup <> participant |||
  Assignment of participants to teamups, n:1 in "classical" cases, e.g. n:2 for Jack & Jill.

  Note: a participant may (technically) join multiple heats in the same round, e.g. on lack of leaders in Jack & Jill
||| 

# adjudication

judge_employment {color: green} |||
  Contains all attributes that apply to a judge's activity within a certain round.
  Please note that this requires the linked referenced account to possess the corresponding jury role, but the latter is not formally modeled (TBD?).
|||
  id uuid pk
  account_id uuid unique=idx_judge -> account
  round_id uuid unique=idx_judge -> round
  floor_id uuid nullable -> floor | only for multi-floor rounds (e.g. university sports), otherwise null
  position_code varchar nullable | only for formations, otherwise null
  draw_order int nullable | TBD purpose?
  status judge_employment_status(absent,present,completed)=absent
  last_active timestamp nullable | last time the judge was active in the round (e.g. round selection or last mark submission)
  confirmed_dances_count int=0 | number of dances already completed by the judge (e.g. to enforce r/o during marks presentation)

mark {color: green} |||
  Stores an actual mark given by one judge for one participant and one dance, 
  such as a selection mark, placement, numeric score, lift, disqualification, or absent mark.
|||
  id uuid pk
  participant_id uuid -> participant | note: in case of a multi-participant teamup, *all* participants must receive marks
  account_id uuid -> account | account under which the judge is working
  dance_id uuid -> dance
  kind mark_kind(selection, placement, score, lift, disqualification, absent, interrupt)
  value numeric nullable | numeric value shall always be given if possible (e.g. last place for disqualification, absent, or canceled)
  reason text nullable | optional (usually sufficiently reflected by kind)

# results

evaluation {color: green} | Flexible key-value result output for DSL and evaluation traceability.
  id uuid pk
  round_id uuid -> round
  participant_id uuid -> participant
  key_path varchar        ||| unique sequence of keys, seperated by ':', syntax: [a-zA-Z0-9_]*(:[a-zA-Z0-9_]*)*
                              example: "SF:3:sum" for Slow Foxtrot, place 3 and better, sum of marks" |||
  value varchar nullable  | usually numeric value, string representation for flexibility
  reason text nullable    | reason for the value, e.g. "disqualified for lift", ideally with rule reference
  result_log_id uuid -> result_log | log reference for legal traceability

result {color: green} |||
  Stores the official placement after a round, which is the competition result if the round is the final one. 
  Detailed traceability values are stored in table evaluation, which also redundantly include the final result.
|||
  id uuid pk
  round_id uuid unique=idx_result-> round
  participant_id uuid unique=idx_result -> participant
  start_class_id uuid nullable -> start_class | non-null only used in combined competition for focussed placement
  age_group_id uuid nullable -> age_group | non-null only used in combined competition for foussed placement
  is_final boolean=false | true iff this is the final result of the competition
  place_from int
  place_to int
  result_log_id uuid -> result_log | log reference for legal traceability


##### gray: Traceability & Logs #####


result_log {color: gray} |||
  Stores traceability hashes on result calculation. Used for both intermediate and final results.
  Outdated entries will remain if the calculation is re-run.
|||
  id uuid pk
  dsl_hash varchar               | hash of the DSL source code used for calculation
  result_hash varchar nullable   | hash of the result data used for calculation (nullable since record must be created *before* calculation)
  account_id uuid -> account     | user account that triggered the calculation
  machine_id varchar             | id of client machine from which the calculation was triggered
  calculation_time timestamp     | timestamp of the calculation

participant_status_event {color: gray} | Stores status changes such as registration, check-in, withdrawal, disqualification, cancellation, and corrections.
  id uuid pk
  participant_id uuid -> participant
  new_status participant_status
  reason text nullable | mandatory for changes relevant to competition report
  account_id uuid -> account | user account that triggered the operation
  machine_id varchar         | id of client machine from which the calculation was triggered
 occurrence_time timestamp

writelog {color: gray} | log of all write operations, also suitable for sync and backup features
  access_time timestamp index | no guuid for efficiency -- index by time is minimum
  uuid item_id | this may reference any item in the DB with a single-id pk
  account_id uuid -> account | user account that triggered the operation
  machine_id varchar         | id of client machine from which the calculation was triggered
  kind write_kind(create, update, delete, undelete) | undelete takes precedence over update when both occur in the same operation


##### fuchsia: Schedule #####


timeslot {color: fuchsia} | a schedule entry, something that occupies a time period on one or more floors
  id uuid pk
  event_id uuid -> event
  competition_id uuid nullable -> competition | non-null iff competition-related (including non-judged, like intro or GL)
  round_id uuid nullable -> round | non-null iff round-related (including non-judged, like GL) and round exists
  kind timeslot_kind(other, intro, practice, presentation, awards, break, goodbye, round)
  round_kind round_kind nullable | iff kind = round
  status timeslot_status(planned, ready, running, completed, canceled)
  name varchar
  num_dances int
  num_heats int
  heat_duration_s int | expected duration of a heat, in seconds
  buffer_duration_s int | expected buffer time for set-up and finishing, in seconds
  expected_duration_s int | expected duration of the timeslot, in seconds
  actual_duration_s int | actual duration of the timeslot, in seconds
  predecessor_syncpoint_id uuid -> syncpoint | this timeslot starts with the given syncpoint
  successor_syncpoint_id uuid -> syncpoint | this triggers the given syncpoint
  note text

rel timeslot <> floor | a floor assigned to a timeslot

syncpoint {color: fuchsia} | a point in time that defines a sequence between 'predecessor' and 'successor' timeslot(s)
  id uuid pk
  event_id uuid -> event
  time timestamp | planned or actual time (planned-time field not helpful due to permanent re-planning)
  earliest_time timestamp nullable | if set, wait until this time has been reached (e.g. announced start time)
  note text


##### orange: External References #####


external {color: orange} | stores one or more external pk's for various kinds of TAS records (polymorphic, expandable)
  kind external_kind(organization, event, competition, participant, person)
  tas_id uuid pk
  idspace_id uuid -> idspace pk
  external_id varchar
  note text nullable

rel external(tas_id) -kind=organization>  organization(id)
rel external(tas_id) -kind=event>         event(id)
rel external(tas_id) -kind=competition>   competition(id)
rel external(tas_id) -kind=participant>   participant(id)
rel external(tas_id) -kind=person>        person(id)

idspace {color: orange} | a namespace for external identifiers, e.g. DTV ESV, DETV, WDSF, etc.
  id uuid pk
  event_id uuid -> event | for client discrimination
  name varchar
  code varchar unique
  note text nullable
