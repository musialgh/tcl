
type timeslot_kind (other, intro, practice, presentation, awards, break, goodbye, round)
type round_kind (other, first, intermediate, semifinal, final, redance, general_look, tie_breaker)
type timeslot_status (planned, ready, running, completed, canceled)

timeslot | a schedule entry, something that occupies a time period on one or more floors
  id uuid pk
  event_id uuid -> event(id)
  competition_id uuid nullable -> competition(id)
  round_id uuid nullable -> round(id)
  kind timeslot_kind
  round_kind round_kind nullable | iff kind = round
  status timeslot_status
  name varchar
  num_dances int
  num_heats int
  heat_duration_s int | expected duration of a heat, in seconds
  buffer_duration_s int | expected buffer time for set-up and finishing, in seconds
  expected_duration_s int | expected duration of the timeslot, in seconds
  actual_duration_s int | actual duration of the timeslot, in seconds
  predecessor_syncpoint_id uuid -> syncpoint(id) | this timeslot starts with the given syncpoint
  successor_syncpoint_id uuid -> syncpoint(id) | this triggers the given syncpoint
  note text

timeslot_x_floor | a floor assigned to a timeslot
  timeslot_id uuid pk -> timeslot(id)
  floor_id uuid pk -> floor(id)

syncpoint | a point in time that defines a sequence between 'predecessor' and 'successor' timeslot(s)
  id uuid pk
  event_id uuid -> event(id)
  time timestamptz | planned or actual time (planned-time field not helpful due to permanent re-planning)
  earliest_time timestamptz nullable | if set, wait until this time has been reached (e.g. announced start time)
  note text
