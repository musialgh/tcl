vars: {
  d2-config: {
    layout-engine: elk
  }
}

org_container: {

  leagues: {
    shape: sql_table
    id: uuid {constraint: primary_key}
    federation_id: uuid {constraint: foreign_key}
    name: varchar
    code: varchar
    competition_year: int
    note: text
  }

  organizations: {
    shape: sql_table
    id: uuid {constraint: primary_key}
    kind: organization_kind
    name: varchar
    code: varchar
    short_name: varchar
    note: text
  }

  organization_external_ids: {
    shape: sql_table
    id: uuid {constraint: primary_key}
    organization_id: uuid {constraint: foreign_key}
    source_system: varchar
    external_id: varchar
    note: text
  }

  federations: {
    shape: sql_table
    id: uuid {constraint: primary_key}
    organization_id: uuid {constraint: foreign_key}
  }
}

people: {

  persons: {
    shape: sql_table
    id: uuid {constraint: primary_key}
    title: varchar
    given_name: varchar
    surname_prefix: varchar
    surname: varchar
    display_name: varchar
    sex: person_sex
    nationality_code: "char(2)"
  }

  participants: {
    shape: sql_table
    id: uuid {constraint: primary_key}
    participant_type_id: uuid {constraint: foreign_key}
    display_name: varchar
    note: text
  }

  competition_entries: {
    shape: sql_table
    id: uuid {constraint: primary_key}
    competition_id: uuid {constraint: foreign_key}
    participant_id: uuid {constraint: foreign_key}
    start_number: int
    status: competition_entry_status
    registered_at_utc: timestamptz
    checked_in_at_utc: timestamptz
    withdrawn_at_utc: timestamptz
    withdrawal_reason: varchar
    disqualified_at_utc: timestamptz
    disqualification_reason: varchar
    note: text
  }

  participant_external_ids: {
    shape: sql_table
    id: uuid {constraint: primary_key}
    participant_id: uuid {constraint: foreign_key}
    source_system: varchar
    external_id: varchar
    note: text
  }

  participant_members: {
    shape: sql_table
    id: uuid {constraint: primary_key}
    participant_id: uuid {constraint: foreign_key}
    person_id: uuid {constraint: foreign_key}
    member_no: int
    member_role: participant_member_role
    organization_id: uuid {constraint: foreign_key}
    is_primary_number_carrier: boolean
  }

  participant_types: {
    shape: sql_table
    id: uuid {constraint: primary_key}
    federation_id: uuid {constraint: foreign_key}
    name: varchar
    code: varchar
    note: text
  }
}

attribs: {

  age_groups: {
  shape: sql_table
  id: uuid {constraint: primary_key}
  federation_id: uuid {constraint: foreign_key}
  name: varchar
  code: varchar
  min_age: int
  max_age: int
  note: text
  }

  start_classes: {
  shape: sql_table
  id: uuid {constraint: primary_key}
  federation_id: uuid {constraint: foreign_key}
  name: varchar
  code: varchar
  sort_order: int
  note: text
  }

  dances: {
    shape: sql_table
    id: uuid {constraint: primary_key}
    federation_id: uuid {constraint: foreign_key}
    competition_discipline_id: uuid {constraint: foreign_key}
    name: varchar
    code: varchar
    note: text
  }

  competition_types: {
    shape: sql_table
    id: uuid {constraint: primary_key}
    federation_id: uuid {constraint: foreign_key}
    name: varchar
    code: varchar
    note: text
  }

  competition_disciplines: {
    shape: sql_table
    id: uuid {constraint: primary_key}
    federation_id: uuid {constraint: foreign_key}
    name: varchar
    code: varchar
    note: text
  }

  competition_forms: {
    shape: sql_table
    id: uuid {constraint: primary_key}
    federation_id: uuid {constraint: foreign_key}
    name: varchar
    code: varchar
    note: text
  }

  competition_orders: {
    shape: sql_table
    id: uuid {constraint: primary_key}
    federation_id: uuid {constraint: foreign_key}
    name: varchar
    code: varchar
    note: text
  }
}

events: {

  tournaments: {
    shape: sql_table
    id: uuid {constraint: primary_key}
    federation_id: uuid {constraint: foreign_key}
    name: varchar
    start_date: date
    end_date: date
    host_organization_id: uuid {constraint: foreign_key}
    organizer_organization_id: uuid {constraint: foreign_key}
    note: text
  }

  tournament_external_ids: {
    shape: sql_table
    id: uuid {constraint: primary_key}
    tournament_id: uuid {constraint: foreign_key}
    source_system: varchar
    external_id: varchar
    note: text
  }
}

venues: {

  halls: {
    shape: sql_table
    id: uuid {constraint: primary_key}
    tournament_id: uuid {constraint: foreign_key}
    name: varchar
    abbreviation: varchar
    note: text
  }

  floors: {
    shape: sql_table
    id: uuid {constraint: primary_key}
    tournament_id: uuid {constraint: foreign_key}
    hall_id: uuid {constraint: foreign_key}
    name: varchar
    abbreviation: varchar
    length_in_meters: "decimal(8,2)"
    width_in_meters: "decimal(8,2)"
    flooring_type_id: uuid {constraint: foreign_key}
    note: text
  }

  flooring_types: {
    shape: sql_table
    id: uuid {constraint: primary_key}
    federation_id: uuid {constraint: foreign_key}
    name: varchar
    code: varchar
  }
}

competition_data: {

  competitions: {
    shape: sql_table
    id: uuid {constraint: primary_key}
    tournament_id: uuid {constraint: foreign_key}
    name: varchar
    planned_start_at: timestamptz
    default_floor_id: uuid {constraint: foreign_key}
    status: competition_status
    competition_type_id: uuid {constraint: foreign_key}
    competition_discipline_id: uuid {constraint: foreign_key}
    competition_form_id: uuid {constraint: foreign_key}
    competition_order_id: uuid {constraint: foreign_key}
    participant_type_id: uuid {constraint: foreign_key}
    age_group_id: uuid {constraint: foreign_key}
    start_class_id: uuid {constraint: foreign_key}
    league_id: uuid {constraint: foreign_key}
    note: text
  }

  competition_external_ids: {
    shape: sql_table
    id: uuid {constraint: primary_key}
    competition_id: uuid {constraint: foreign_key}
    source_system: varchar
    external_id: varchar
    note: text
  }

  competition_dances: {
    shape: sql_table
    id: uuid {constraint: primary_key}
    competition_id: uuid {constraint: foreign_key}
    dance_id: uuid {constraint: foreign_key}
    sequence_no: int
    note: text
  }

  competition_judges: {
    shape: sql_table
    id: uuid {constraint: primary_key}
    competition_id: uuid {constraint: foreign_key}
    person_id: uuid {constraint: foreign_key}
    panel_letter: varchar
    note: text
  }

  competition_rounds: {
    shape: sql_table
    id: uuid {constraint: primary_key}
    competition_id: uuid {constraint: foreign_key}
    number: int
    kind: competition_round_kind
    status: competition_round_status
    name: varchar
    floor_id: uuid {constraint: foreign_key}
    planned_start_at: timestamptz
    started_at_utc: timestamptz
    completed_at_utc: timestamptz
    note: text
  }

  competition_round_judges: {
    shape: sql_table
    id: uuid {constraint: primary_key}
    round_id: uuid {constraint: foreign_key}
    competition_judge_id: uuid {constraint: foreign_key}
    position_code: varchar
    draw_order: int
    note: text
  }
}

  
participation: {
  
  competition_results: {
    shape: sql_table
    id: uuid {constraint: primary_key}
    competition_id: uuid {constraint: foreign_key}
    competition_entry_id: uuid {constraint: foreign_key}
    final_rank_from: int
    final_rank_to: int
    is_finalist: boolean
    note: text
  }
  
  competition_round_results: {
    shape: sql_table
    id: uuid {constraint: primary_key}
    round_id: uuid {constraint: foreign_key}
    competition_entry_id: uuid {constraint: foreign_key}
    next_round_id: uuid {constraint: foreign_key}
    rank_from: int
    rank_to: int
    note: text
  }

  competition_round_heats: {
    shape: sql_table
    id: uuid {constraint: primary_key}
    round_id: uuid {constraint: foreign_key}
    number: int
    dance_id: uuid {constraint: foreign_key}
    name: varchar
    note: text
  }

  competition_round_heat_results: {
    shape: sql_table
    id: uuid {constraint: primary_key}
    heat_id: uuid {constraint: foreign_key}
    competition_entry_id: uuid {constraint: foreign_key}
    rank_from: int
    rank_to: int
    note: text
  }

  competition_round_heat_entries: {
    shape: sql_table
    id: uuid {constraint: primary_key}
    heat_id: uuid {constraint: foreign_key}
    competition_entry_id: uuid {constraint: foreign_key}
    start_order: int
  }
}



# Relationships
org_container.federations.organization_id -> org_container.organizations.id
org_container.organization_external_ids.organization_id -> org_container.organizations.id

venues.flooring_types.federation_id -> org_container.federations.id
attribs.competition_types.federation_id -> org_container.federations.id
attribs.competition_disciplines.federation_id -> org_container.federations.id
attribs.competition_forms.federation_id -> org_container.federations.id
attribs.competition_orders.federation_id -> org_container.federations.id
people.participant_types.federation_id -> org_container.federations.id
attribs.age_groups.federation_id -> org_container.federations.id
attribs.start_classes.federation_id -> org_container.federations.id
org_container.leagues.federation_id -> org_container.federations.id
attribs.dances.federation_id -> org_container.federations.id
attribs.dances.competition_discipline_id -> attribs.competition_disciplines.id

events.tournaments.federation_id -> org_container.federations.id
events.tournaments.host_organization_id -> org_container.organizations.id
events.tournaments.organizer_organization_id -> org_container.organizations.id
events.tournament_external_ids.tournament_id -> events.tournaments.id

venues.halls.tournament_id -> events.tournaments.id

venues.floors.tournament_id -> events.tournaments.id
venues.floors.hall_id -> venues.halls.id
venues.floors.flooring_type_id -> venues.flooring_types.id

people.participants.participant_type_id -> people.participant_types.id
people.participant_external_ids.participant_id -> people.participants.id
people.participant_members.participant_id -> people.participants.id
people.participant_members.person_id -> people.persons.id
people.participant_members.organization_id -> org_container.organizations.id

competition_data.competitions.tournament_id -> events.tournaments.id
competition_data.competitions.default_floor_id -> venues.floors.id
competition_data.competitions.competition_type_id -> attribs.competition_types.id
competition_data.competitions.competition_discipline_id -> attribs.competition_disciplines.id
competition_data.competitions.competition_form_id -> attribs.competition_forms.id
competition_data.competitions.competition_order_id -> attribs.competition_orders.id
competition_data.competitions.participant_type_id -> people.participant_types.id
competition_data.competitions.age_group_id -> attribs.age_groups.id
competition_data.competitions.start_class_id -> attribs.start_classes.id
competition_data.competitions.league_id -> org_container.leagues.id
competition_data.competition_external_ids.competition_id -> competition_data.competitions.id

competition_data.competition_dances.competition_id -> competition_data.competitions.id
competition_data.competition_dances.dance_id -> attribs.dances.id

competition_data.competition_judges.competition_id -> competition_data.competitions.id
competition_data.competition_judges.person_id -> people.persons.id

people.competition_entries.competition_id -> competition_data.competitions.id
people.competition_entries.participant_id -> people.participants.id

competition_data.competition_rounds.competition_id -> competition_data.competitions.id
competition_data.competition_rounds.floor_id -> venues.floors.id
competition_data.competition_round_judges.round_id -> competition_data.competition_rounds.id
competition_data.competition_round_judges.competition_judge_id -> competition_data.competition_judges.id

participation.competition_round_results.round_id -> competition_data.competition_rounds.id
participation.competition_round_results.competition_entry_id -> people.competition_entries.id
participation.competition_round_results.next_round_id -> competition_data.competition_rounds.id

participation.competition_round_heats.round_id -> competition_data.competition_rounds.id
participation.competition_round_heats.dance_id -> attribs.dances.id

participation.competition_round_heat_entries.heat_id -> participation.competition_round_heats.id
participation.competition_round_heat_entries.competition_entry_id -> people.competition_entries.id

participation.competition_round_heat_results.heat_id -> participation.competition_round_heats.id
participation.competition_round_heat_results.competition_entry_id -> people.competition_entries.id

participation.competition_results.competition_id -> competition_data.competitions.id
participation.competition_results.competition_entry_id -> people.competition_entries.id
