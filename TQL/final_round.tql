# TSO Final Round — Skating System (Anhang 2, Rules 5–11)
# Assumes: marks and report tables are pre-created by the environment.
#
# Report layout written here:
#   Dance-level (group-1 = dance name):
#     key '1'|'1-2'|… → majority count at that threshold (value), sum of qualifying marks (reason)
#     key 'place-min'|'place-max'|'place-value' → placement bounds and average
#   Round-level (group-1 = NULL):
#     key = dance name → place-value for that dance
#     key 'sum'        → sum of dance places (Rule 9a)
#     key 'place-min'|'place-max'|'place-value' → final round placement


# Rules 5–8: iterative majority placement engine.
#
# dm           : (start, value) — raw marks; value = mark given (1 = best)
# n_eff        : effective judge count; majority when cnt*2 > n_eff
# wt           : (start, pm, px) — place-range working table, modified in place;
#                caller must initialise pm/px to the desired search range
# report_dance : dance label written to report entries (NULL = skip report writes)
# report       : report table, modified in place
FUNCTION evaluate_marks_placement(dm, n_eff, wt, report_dance, report):
    LET n_max = SELECT MAX(value) FROM dm
    LET ns    = SELECT COUNT(DISTINCT start) FROM wt

    FOR t IN 1..ns ASC:
        WHEN t > n_max:
            BREAK
        WHEN COUNT(*) FROM (SELECT start FROM wt WHERE pm < px) = 0:
            BREAK

        LET unr = SELECT start FROM wt WHERE pm < px

        LET cq = SELECT dm.start AS start, COUNT(*) AS cnt, SUM(dm.value) AS sm
            FROM dm
            WHERE dm.value <= t AND dm.start IN unr.start
            GROUP BY dm.start
        LET qual = SELECT start, cnt, sm FROM cq WHERE cnt * 2 > n_eff

        WHEN COUNT(*) FROM qual = 0:
            CONTINUE

        WHEN report_dance IS NOT NULL:
            LET lbl = "1-{t}"
            WHEN t = 1:
                LET lbl = '1'
            INSERT INTO report VALUES
                SELECT q.start AS start, report_dance AS g1, lbl AS k,
                       q.cnt AS v, "Summe {q.sm}" AS r
                FROM qual AS q
                USING start AS start, g1 AS group-1, k AS key, v AS value, r AS reason

        # Join pm/px into qual; all qual starts are unresolved, so every qual row
        # has a matching q_grp row (no CONCAT TO abort risk).
        LET q_grp = SELECT w.start AS start, w.pm AS pm, w.px AS px
            FROM wt AS w WHERE w.pm < w.px AND w.start IN qual.start
        CONCAT TO qual FROM q_grp USING pm, px

        LET grp_pms = SELECT DISTINCT pm FROM qual ORDER BY pm ASC

        FOR gpm IN grp_pms.pm:
            LET grp_q     = SELECT start, cnt, sm, px FROM qual WHERE pm = gpm
            # Capture non-qualifying starts before any wt updates alter their pm.
            LET grp_non_q = SELECT start FROM wt
                WHERE pm = gpm AND NOT (start IN grp_q.start)
            LET nq     = SELECT COUNT(*) FROM grp_q
            LET grp_qs = SELECT start, cnt, sm FROM grp_q ORDER BY cnt DESC, sm ASC
            LET nxt_gpm = gpm
            LET gst     = 1

            # Walk sorted starts and flush a sub-group whenever (cnt, sm) changes.
            FOR i IN 1..nq ASC:
                LET eog = 1
                WHEN i < nq:
                    LET ra = grp_qs[i]
                    LET rb = grp_qs[i + 1]
                    WHEN ra.cnt = rb.cnt AND ra.sm = rb.sm:
                        LET eog = 0

                WHEN eog = 1:
                    LET sg_sz = i - gst + 1
                    LET sg_pm = nxt_gpm
                    LET sg_px = nxt_gpm + sg_sz - 1
                    FOR k IN gst..i ASC:
                        LET rk = grp_qs[k]
                        UPDATE wt WHERE start = rk.start
                            SET { pm = sg_pm, px = sg_px }
                    LET nxt_gpm = nxt_gpm + sg_sz
                    LET gst     = i + 1

            # Non-qualifying starts advance their pm past the qualifying batch;
            # px is unchanged (they remain in contention for the remaining places).
            UPDATE wt WHERE start IN grp_non_q.start
                SET { pm = nxt_gpm }


# Evaluate one dance (Rules 5–8) and write placement entries to report.
FUNCTION evaluate_single_dance(dance_name, report):
    LET dm  = SELECT start, value FROM marks WHERE round_element = dance_name
    LET fst = SELECT FIRST(start) FROM dm
    LET nj  = SELECT COUNT(*) FROM dm WHERE start = fst
    LET ns  = SELECT COUNT(DISTINCT start) FROM dm
    LET wt  = SELECT DISTINCT start, 1 AS pm, ns AS px FROM dm

    evaluate_marks_placement(dm, nj, wt, dance_name, report)

    INSERT INTO report VALUES
        SELECT start AS start, dance_name AS g1, 'place-min' AS k, pm AS v, NULL AS r
        FROM wt
        USING start AS start, g1 AS group-1, k AS key, v AS value, r AS reason
    INSERT INTO report VALUES
        SELECT start AS start, dance_name AS g1, 'place-max' AS k, px AS v, NULL AS r
        FROM wt
        USING start AS start, g1 AS group-1, k AS key, v AS value, r AS reason
    INSERT INTO report VALUES
        SELECT start AS start, dance_name AS g1, 'place-value' AS k,
               (pm + px) / 2 AS v, NULL AS r
        FROM wt
        USING start AS start, g1 AS group-1, k AS key, v AS value, r AS reason


# Evaluate the full round (Rules 9–11) using dance place-values stored in report.
FUNCTION evaluate_round(report):
    LET dp = SELECT start, [group-1] AS dance, value AS place
        FROM report WHERE key = 'place-value' AND [group-1] IS NOT NULL

    LET ns = SELECT COUNT(DISTINCT start) FROM dp
    LET nd = SELECT COUNT(DISTINCT dance)  FROM dp

    # Judge count is uniform across all (start, dance) combinations.
    LET any_start = SELECT FIRST(start) FROM dp
    LET any_dance = SELECT FIRST(dance)  FROM dp
    LET nj = SELECT COUNT(*) FROM marks
        WHERE start = any_start AND round_element = any_dance

    # Rule 9a: sum of dance places per start.
    LET sums = SELECT start, SUM(place) AS tot FROM dp GROUP BY start

    # Write per-dance place columns to the round section of report (group-1 = NULL).
    LET dances = SELECT DISTINCT dance FROM dp ORDER BY dance ASC
    FOR dn IN dances.dance:
        INSERT INTO report VALUES
            SELECT p.start AS start, NULL AS g1, dn AS k, p.place AS v, NULL AS r
            FROM dp AS p WHERE p.dance = dn
            USING start AS start, g1 AS group-1, k AS key, v AS value, r AS reason
    INSERT INTO report VALUES
        SELECT s.start AS start, NULL AS g1, 'sum' AS k, s.tot AS v, NULL AS r
        FROM sums AS s
        USING start AS start, g1 AS group-1, k AS key, v AS value, r AS reason

    LET wt = SELECT start, 1 AS pm, ns AS px FROM sums

    LET tot_vals = SELECT DISTINCT tot FROM sums ORDER BY tot ASC
    LET nxt_pm = 1

    FOR tv IN tot_vals.tot:
        LET grp    = SELECT start FROM sums WHERE tot = tv
        LET nq_grp = SELECT COUNT(*) FROM grp
        LET grp_px = nxt_pm + nq_grp - 1

        UPDATE wt WHERE start IN grp.start
            SET { pm = nxt_pm, px = grp_px }

        # Rule 9b / 10: tie-break within this sum group.
        WHEN nq_grp > 1:
            LET target_place = nxt_pm

            # Count and sum of dance places <= target_place per start.
            # Initialise all group starts with 0 so starts with no qualifying
            # dance places still appear in cq10 (Rule 10 is a one-shot comparison,
            # not a majority threshold, so 0 is a valid score).
            LET cq10 = SELECT start, 0 AS cnt, 0 AS sm FROM grp
            LET dp_agg = SELECT p.start AS start, COUNT(*) AS cnt, SUM(p.place) AS sm
                FROM dp AS p
                WHERE p.start IN grp.start AND p.place <= target_place
                GROUP BY p.start
            UPDATE cq10 FROM dp_agg

            LET cq10_s  = SELECT start, cnt, sm FROM cq10 ORDER BY cnt DESC, sm ASC
            LET nq10    = SELECT COUNT(*) FROM cq10
            LET nxt_gpm = nxt_pm
            LET gst10   = 1

            FOR i IN 1..nq10 ASC:
                LET eog10 = 1
                WHEN i < nq10:
                    LET ra10 = cq10_s[i]
                    LET rb10 = cq10_s[i + 1]
                    WHEN ra10.cnt = rb10.cnt AND ra10.sm = rb10.sm:
                        LET eog10 = 0

                WHEN eog10 = 1:
                    LET sg_sz10 = i - gst10 + 1
                    LET sg_pm10 = nxt_gpm
                    LET sg_px10 = nxt_gpm + sg_sz10 - 1

                    WHEN sg_sz10 = 1:
                        # Rule 10 resolved this start uniquely.
                        LET rk10 = cq10_s[gst10]
                        UPDATE wt WHERE start = rk10.start
                            SET { pm = sg_pm10, px = sg_px10 }
                    ELSE:
                        # Rule 11: apply Rules 5–8 to all marks from all dances
                        # combined.  n_eff = nj * nd (one virtual panel per dance).
                        LET tied_starts = SELECT start FROM cq10_s
                            WHERE cnt = cq10_s[gst10].cnt AND sm = cq10_s[gst10].sm
                        LET dm11    = SELECT start, value FROM marks
                            WHERE start IN tied_starts.start
                        LET n_eff11 = nj * nd
                        LET wt11    = SELECT start, sg_pm10 AS pm, sg_px10 AS px
                            FROM tied_starts
                        evaluate_marks_placement(dm11, n_eff11, wt11, NULL, report)
                        # Copy refined pm/px back to the global working table.
                        UPDATE wt FROM wt11

                    LET nxt_gpm = nxt_gpm + sg_sz10
                    LET gst10   = i + 1

        LET nxt_pm = nxt_pm + nq_grp

    INSERT INTO report VALUES
        SELECT start AS start, NULL AS g1, 'place-min' AS k, pm AS v, NULL AS r
        FROM wt
        USING start AS start, g1 AS group-1, k AS key, v AS value, r AS reason
    INSERT INTO report VALUES
        SELECT start AS start, NULL AS g1, 'place-max' AS k, px AS v, NULL AS r
        FROM wt
        USING start AS start, g1 AS group-1, k AS key, v AS value, r AS reason
    INSERT INTO report VALUES
        SELECT start AS start, NULL AS g1, 'place-value' AS k,
               (pm + px) / 2 AS v, NULL AS r
        FROM wt
        USING start AS start, g1 AS group-1, k AS key, v AS value, r AS reason


# Main: evaluate each dance in order, then aggregate for the round.
LET dances = SELECT DISTINCT round_element FROM marks ORDER BY round_element ASC
FOR dance IN dances.round_element:
    evaluate_single_dance(dance, report)
evaluate_round(report)
