# ===============================================
# Implementation of cross-majority-skating scheme 
# ===============================================


IMPORT "tas-evaluation-interface.tql";


# Evaluate elimination round (crosses)
# \param round      [in] : key of round to evaluate
FUNCTION evaluate_round_elimination(round):

    # extract current round from marks for readability
    LET round_marks = SELECT start, round_element AS dance, adjudicator, value FROM marks 
                        WHERE marks.round = round;

    # compute number of crosses per dance
    LET dance_counts = SELECT start, round, dance AS round_element, 'marks' AS key, COUNT(value) AS value,
                                 "F 6.8.1: count of marks" AS reason
                        FROM round_marks GROUP BY start, dance;
    INSERT INTO report VALUES dance_counts;

    # compute total number of crosses
    LET total_counts = SELECT start, round, 'marks' AS key, SUM(value) AS value,
                                "F 6.8.1: count of marks" AS reason
                        FROM dance_counts GROUP BY start;
    INSERT INTO report VALUES total_counts;

    # generate placing
    FOR s IN total_counts:
        LET placing = SELECT                  1 + COUNT(value < s.value) AS place_min,
                             ROWS(total_counts) - COUNT(value > s.value) AS place_max 
                        FROM total_counts;
        IF placing.place_min = placing.place_max:
            LET reason = "F 6.8.1: single rank {placing.place_min} in count of marks";
        ELSE:
            LET reason = "F 6.8.1: shared rank {placing.place_min}..{placing.place_max} in count of marks";
        INSERT INTO report VALUES
            ROW(start, round, 'place_min' AS key, placing.place_min AS value, reason),
            ROW(start, round, 'place_max' AS key, placing.place_max AS value, reason);

# evaluate_round_elimination()


# Evaluate one dance in a final
# \param starts     [in] : table (start) with all starts 
# \param jury       [in] : table (judge) with all adjudicators
# \param round      [in] : key of round to evaluate
# \param dance      [in] : key of dance to evaluate
FUNCTION evaluate_dance_final(starts, jury, round, dance):

    # extract current dance from marks for readability
    LET dance_marks = SELECT start, adjudicator, value FROM marks 
                        WHERE marks.round = round AND round_element = dance;

    LET unplaced = starts; # will be reduced on every place assignment
    WHILE ROWS(unplaced):
    
        LET for_place  = ROWS(starts) - ROWS(unplaced) + 1; # next place to assign
        LET candidates = unplaced;                          # iterate criteria on <candidates> until 1 remains
        
        FOR by_place IN 1 .. ROWS(starts): # place where counts and sums are read from (decreasing priotity)

            # fetch count and sum for placing <by_place>
            LET candidates = SELECT start, COUNT(value) AS num, SUM(value) AS sum FROM dance_marks 
                                WHERE start IN candidates.start AND value <= by_place GROUP BY start;
            # suppress sub-majority results (note: TSO also reports sub-majority counts -- but we don't like that!)
            LET candidates = SELECT * FROM candidates WHERE 2 * num > ROWS(jury);

            # report counts considered
            CALL report_count(candidates, round, dance, group = NULL, by_place, "Rules 5,6 for place {by_place}");
            # fetch best-count occurrences among candidates
            LET candidates = SELECT * FROM candidates ORDER BY num DESC LIMIT 1 ON DISTINCT num;
            # try to resolve on count
            IF  ROWS(candidates) = 1:
                CALL assign_place(unplaced, candidates.start, round, dance, for_place, for_place,
                                    "Rules 5,6,8: highest majority count {candidates.num} on place {by_place}");
                LET candidates = SELECT * FROM candidates WHERE FALSE;

            # report sums considered
            CALL report_sum(candidates, round, dance, group = NULL, by_place, "Rule 7 for place {by_place}");
            # fetch best-sum occurrences among candidates
            LET candidates = SELECT * FROM candidates ORDER BY sum ASC LIMIT 1 ON DISTINCT sum;
            # try to resolve on sum
            IF  ROWS(candidates) = 1:
                CALL assign_place(unplaced, candidates.start, round, dance, for_place, for_place,
                                    "Rules 7a,b: majority count {candidates.num} "
                                    "with lowest sum {candidates.sum} on place {by_place}");
                LET candidates = SELECT * FROM candidates WHERE FALSE;

        # criterions exhausted: share place for remaining candidates
        FOR c IN candidates:
                CALL assign_place(unplaced, c.start, round, dance, for_place, for_place + ROWS(candidates) - 1, 
                                    "Rule 7c: shared highest majority count {c.num}, sum {c.sum} on place {by_place}");
            
# evaluate_dance_final()


# Evaluate final round with skating
# \param round      [in] : key of round to evaluate
# \param do_skating [in] : resolve ties via skating rules 10, 11 if TRUE
FUNCTION evaluate_round_final(round, do_skating = FALSE):

    # extract current round from marks for readability
    LET final_marks = SELECT start, round_element AS dance, adjudicator, value FROM marks 
                        WHERE marks.round = round;

    # define some helpers for shorter notation below
    LET starts      = SELECT start                  FROM final_marks GROUP BY start;
    LET jury        = SELECT adjudicator AS judge   FROM final_marks GROUP BY judge;
    LET dances      = SELECT round_element AS dance FROM final_marks GROUP BY dance;

    # evaluate all dances
    FOR dance IN dances: CALL evaluate_dance_final(starts, jury, round, dance);

    # compute places sum over dances and add to report
    LET places_sums = SELECT start, round, "places_sum" AS key, SUM(value) AS value, 
                            "Rule 9a: sum of places over {ROWS(dances)} dances" AS reason FROM report
                        WHERE report.round = round AND round_element IS NOT NULL AND key = "place_val"
                        GROUP BY start;
    # report global sum column
    INSERT INTO report VALUES places_sums;

    LET unplaced = places_sums; # will be reduced on every place assignment
    WHILE ROWS(unplaced):
    
        LET for_place  = ROWS(starts) - ROWS(unplaced) + 1; # next place to assign
        LET candidates = SELECT start, value AS sum FROM unplaced 
                                ORDER BY sum ASC LIMIT 1 ON DISTINCT sum;

        # try to resolve on sum only
        ELSE IF ROWS(candidates) = 1:
            CALL assign_place(unplaced, candidates.start, round, dance = NULL, for_place, for_place,
                              "Rule 9a: lowest sum {candidates.sum} of places over {ROWS(dances)} dances");
        ELSE IF ROWS(candidates) > 1 AND NOT do_skating:
            FOR c IN candidates:
                CALL assign_place(unplaced, c.start, round, dance = NULL, for_place, for_place + ROWS(candidates) - 1,
                                  "No skating: shared lowest sum {c.sum} of places over {ROWS(dances)} dances");
        # apply skating if configured
        ELSE IF  ROWS(candidates) > 1 AND do_skating:
            CALL perform_skating(unplaced       = unplaced, 
                                 tie            = candidates, 
                                 starts         = starts,
                                 jury           = jury, 
                                 round          = round, 
                                 dances         = dances, 
                                 final_marks    = final_marks,
                                 for_place      = for_place);
        # cannot/should not/will not happen, but would deadlock
        ELSE: ABORT "internal error: <candidates> empty";

# evaluate_round_final_skating()


# Apply skating rules 10, 11 to given tie group.
# \param unplaced   [inout] : table (start, sum): all yet unplaced starts, for reducing
# \param tie           [in] : table (start, sum): current tie group, subset of <unplaced>
# \param starts        [in] : table (start) with all starts 
# \param jury          [in] : table (judge) with all adjudicators
# \param round         [in] : round id
# \param dances        [in] : table (dance) with all dances
# \param final_marks   [in] : marks subset for current final round
# \param for-place     [in] : place to be assigned next
FUNCTION perform_skating(unplaced, tie, starts, jury, round, dances, final_marks, for_place):

    LET candidates = tie; # enforce [in] semantics while reducing <candidates>

    # report r10 application
    LET apply_r10 = SELECT start, round, "R10-applied" AS group, for_place AS subgroup, 
                           "Rule 9b: sum {sum} tie on place {for_place}" AS reason FROM candidates;
    INSERT INTO report VALUES apply_r10;
    # fetch counts and sums better or equal target place
    LET candidates = SELECT start, COUNT(value) AS num, SUM(value) AS sum FROM report
                        WHERE report.round = round AND round_element IS NOT NULL AND key = "place_val" 
                                AND value <= for_place
                        GROUP BY start;
 
    # report counts considered
    CALL report_count(candidates, round, dance = NULL, group = "R10-criteria", by_place, 
                        "Rules 10a,b for place {for_place}";
    # fetch best-count occurrences among candidates
    LET candidates = SELECT * FROM candidates ORDER BY num DESC LIMIT 1 ON DISTINCT num;
    # try to resolve on count
    IF  ROWS(candidates) = 1:
        CALL assign_place(unplaced, candidates.start, round, dance = NULL, for_place, for_place,
                            "Rules 10a,b: highest count {candidates.num} on place {for_place}");
        RETURN;

    # report sums considered
    CALL report_sum(candidates, round, dance = NULL, group = "R10-criteria", by_place, 
                        "Rules 10c,d for place {for_place}";
    # fetch best-sum occurrences among candidates
    LET candidates = SELECT * FROM candidates ORDER BY sum ASC LIMIT 1 ON DISTINCT sum;
    # try to resolve on sum
    IF  ROWS(candidates) = 1:
        CALL assign_place(unplaced, candidates.start, round, dance = NULL, for_place, for_place,
                            "Rules 10c,d: lowest sum {candidates.sum} on place {for_place}");
        RETURN;

    # report r11 application
    LET apply_r11 = SELECT start, round, "R11-applied" AS group, for_place AS subgroup, 
                           "Rule 10e: sum {sum} tie on place {for_place}" AS reason FROM candidates;
    INSERT INTO report VALUES apply_r11;
    
    FOR by_place IN for_place .. ROWS(starts)
        # fetch counts and sums 
        LET candidates = SELECT start, COUNT(value) AS num, SUM(value) AS sum FROM final_marks
                            WHERE start IN candidates.start AND value <= by_place GROUP BY start;
        # suppress sub-majority results (note: TSO also reports sub-majority counts -- but we don't like that!)
        LET candidates = SELECT * FROM candidates WHERE 2 * num > ROWS(jury) * ROWS(dances);

        # report counts considered by R11
        CALL report_count(candidates, round, dance = NULL, group = "R11-criteria", by_place, 
                            "Rules 11,5,6 for place {by_place}");
        # fetch best-count occurrences among candidates
        LET candidates = SELECT * FROM candidates ORDER BY num DESC LIMIT 1 ON DISTINCT num;
        # try to resolve on count
        IF  ROWS(candidates) = 1:
            CALL assign_place(unplaced, candidates.start, round, dance = NULL, for_place, for_place,
                                "Rules 11,5,6: highest count {candidates.num} on place {for_place}");
            RETURN;
                
        # report sums considered by R11
        CALL report_count(candidates, round, dance = NULL, group = "R11-criteria", by_place, 
                            "Rules 11,7 for place {by_place}");
        # fetch best-count occurrences among candidates
        LET candidates = SELECT * FROM candidates ORDER BY sum ASC LIMIT 1 ON DISTINCT sum;
        # try to resolve on count
        IF  ROWS(candidates) = 1:
            CALL assign_place(unplaced, candidates.start, round, dance = NULL, for_place, for_place,
                                "Rules 11,7: lowest sum {candidates.sum} on place {for_place}");
            RETURN;
        
    # share place among remaining candidates
    FOR c IN candidates:
        CALL assign_place(unplaced, c.start, round, dance = NULL, for_place, for_place + ROWS(candidates) - 1,
                         "Rules 11,7c: sharing place {for_place} due to same counts and sums for this place and lower");

# perform_skating()


# ================================== Helpers ==================================


# Process a single or shared place assigment for a dance *or* round 
# \param unplaced   [inout] : remaining tie group, table (start, ...)
# \param start         [in] : start id
# \param round         [in] : round id
# \param dance         [in] : dance id (if NULL, treat as round place assignment)
# \param place_min     [in] : start value of assigned place range
# \param place_max     [in] : end value of assigned place range
# \param reason        [in] : textual description of assignment rationale
FUNCTION assign_place(unplaced, start, round, dance, place_min, place_max, reason = NULL):
    # drop start we just assigned (call by reference)
    LET unplaced = SELECT * FROM unplaced WHERE unplaced.start <> start;
    # add placing to report
    INSERT INTO report VALUES ROW(start, round, round_element = dance, key = 'place_min', value = place_min, reason);
    INSERT INTO report VALUES ROW(start, round, round_element = dance, key = 'place_max', value = place_max, reason);
    # only for dance evaluation, we also need a place value for aggregation
    IF dance IS NULL: RETURN
    INSERT INTO report VALUES ROW(start, round, round_element = dance, key = 'place_val', 
                                    value = (place_min + place_max) / 2, 
                                    reason = IF(place_min = place_max, NULL, "Rule 7d: average of {place-min}..{place_max}"));
# assign_place()


# Report count attributes for rules using count fields.
# \param candidates    [in] : table (start, num, sum) to report values from
# \param round         [in] : round id
# \param dance         [in] : dance id
# \param group         [in] : optional group header, intended for skating rules
# \param place         [in] : place the attribute belongs to
# \param reason        [in] : textual description of entry
FUNTION report_count(round, dance = NULL, group = NULL, place, candidates, reason = NULL):
    FOR c IN candidates:
        row = ROW(c.start, round, round_element = dance, group, subgroup = place, key = 'count', value = c.num, reason);
        # we must "manually" check if entry already exists (no suitable indexing)
        IF NOT SELECT COUNT(*) FROM report WHERE VALUES MATCH row:
            INSERT INTO report VALUES row;
# report_count()


# Report sum attributes for rules using sum fields.
# \param candidates    [in] : table (start, num, sum) to report values from
# \param round         [in] : round id
# \param dance         [in] : dance id
# \param group         [in] : optional group header, intended for skating rules
# \param place         [in] : place the attribute belongs to
# \param reason        [in] : textual description of assignment rationale
FUNTION report_sum(round, dance, place, candidates):
    FOR c IN candidates:
        row = ROW(c.start, round, round_element = dance, group, subgroup = place, key = 'sum', value = c.sum, reason);
        # we must "manually" check if entry already exists (no suitable indexing)
        IF NOT SELECT COUNT(*) FROM report WHERE VALUES MATCH row:
            INSERT INTO report VALUES row;
# report_sum()