# ===============================================
# Implementation of cross-majority-skating scheme 
# ===============================================


IMPORT "tas-evaluation-interface.tql";


# Provide a few global helper objects for readability purposes
FUNCTION init_globals():
    GLOBAL marks, round, report;    # TAS interface
    GLOBAL starts   = SELECT start                  FROM marks WHERE marks.round = round GROUP BY start;
    GLOBAL jury     = SELECT adjudicator   AS judge FROM marks WHERE marks.round = round GROUP BY judge;
    GLOBAL dances   = SELECT round_element AS dance FROM marks WHERE marks.round = round GROUP BY dance;
    GLOBAL unplaced = starts;       # to be reduced on final place assignments
# init_globals()


# Evaluate elimination round (crosses)
FUNCTION evaluate_round_elimination():
    GLOBAL marks, round, report; # TAS interface

    # extract current round from marks for readability
    LET round_marks = SELECT start, round_element AS dance, adjudicator, value FROM marks 
                        WHERE marks.round = round;

    # compute number of crosses per dance
    LET dance_counts = SELECT start, round, dance AS round_element, 'marks' AS key, COUNT(value) AS value,
                                 "F6.8.1: count of marks" AS reason
                        FROM round_marks GROUP BY start, dance;
    INSERT INTO report VALUES dance_counts;

    # compute total number of crosses
    LET total_counts = SELECT start, round, 'marks' AS key, SUM(value) AS value,
                                "F6.8.1: count of marks" AS reason
                        FROM dance_counts GROUP BY start;
    INSERT INTO report VALUES total_counts;

    # generate placing
    FOR s IN total_counts:
        LET placing = SELECT                  1 + COUNT(value < s.value) AS place_min,
                             ROWS(total_counts) - COUNT(value > s.value) AS place_max 
                        FROM total_counts;
        IF placing.place_min = placing.place_max:
            LET reason = "F6.8.1: single rank {placing.place_min} in count of marks";
        ELSE:
            LET reason = "F6.8.1: shared rank {placing.place_min}..{placing.place_max} in count of marks";
        INSERT INTO report VALUES
            ROW(start, round, 'place_min' AS key, placing.place_min AS value, reason),
            ROW(start, round, 'place_max' AS key, placing.place_max AS value, reason);
# evaluate_round_elimination()


# Evaluate one dance in a final
FUNCTION evaluate_dance_final(dance): # key of dance to evaluate
    GLOBAL marks, round, starts, unplaced; # init_globals() has been called for round already
    
    # extract current dance from marks for readability
    LET dance_marks = SELECT start, adjudicator, value FROM marks 
                        WHERE marks.round = round AND round_element = dance;

    # invoke counts-and-sums refinement for everyone until each start has been placed
    LET unplaced = starts;
    WHILE ROWS(unplaced): CALL refine_counts_and_sums(dance_marks, unplaced, dance);
# evaluate_dance_final()


# Evaluate counts-and-sums cascade (for a single dance *or* R11) to obtain the next (possibly shared) place assignment
FUNCTION refine_counts_and_sums(marks,              # table (start, dance, adjudicator, value) with relevant marks
                                candidates,         # table (start) with starts to consider
                                dance = NULL,       # dance id (if NULL, treat as round place assignment)
                                min_by_place = 1):  # place to start evaluation with (default 1 for single dance)
    GLOBAL starts, unplaced; # TAS interface

    LET for_place  = ROWS(starts) - ROWS(unplaced) + 1; # next place to assign
    LET max_marks  = ROWS(marks) / ROWS(starts);        # for majority check: marks per start
    LET group      = IF(dance, NULL, "R11-criteria");   # group header for count/sum reporting

    FOR by_place IN min_by_place .. ROWS(starts): # place where counts and sums are read from (decreasing priority)

        # fetch count and sum for placing <by_place>
        LET scores = SELECT start, COUNT(value) AS num, SUM(value) AS sum FROM marks 
                        WHERE start IN candidates AND value <= by_place GROUP BY start;
        # suppress sub-majority results (note: TSO also reports sub-majority counts -- but we don't like that!)
        LET scores = SELECT * FROM scores WHERE 2 * num > max_marks;
        # if no scores found yet, we must not restrict our candidates, but go on with all of them
        IF NOT ROWS(scores): CONTINUE;

        # report counts considered
        CALL report_count(scores, dance, group, by_place, "R5,6 for places {by_place} and better");
        # fetch best-count occurrences among candidates
        LET scores = SELECT * FROM scores ORDER BY num DESC LIMIT 1 ON DISTINCT num;
        # try to resolve on count
        IF ROWS(scores) = 1:
            RETURN assign_place(scores.start, dance, for_place,
                                "R5,6,8: highest majority count {scores.num} on place {by_place}");

        # report sums considered
        CALL report_sum(scores, dance, group, by_place, "R7 for places {by_place} and better");
        # fetch best-sum occurrences among candidates
        LET scores = SELECT * FROM scores ORDER BY sum ASC LIMIT 1 ON DISTINCT sum;
        # try to resolve on sum
        IF ROWS(scores) = 1:
            RETURN assign_place(scores.start, dance, for_place,
                                "R7a,b: highest majority count {scores.num} "
                                "with lowest sum {scores.sum} on place {by_place}");

        # restrict tie to consider for next iteration
        LET candidates = scores.start;

    # criteria exhausted: share place for remaining candidates
    CALL assign_place(candidates, dance, for_place,
                        "R7c: shared majority counts and sums on places {min_by_place} and below");
# refine_counts_and_sums()


# Evaluate final round, optionally with skating (default yes)
FUNCTION evaluate_round_final(do_skating = TRUE): # resolve ties via skating rules 10, 11 if TRUE
    # prepare environment
    CALL init_globals();
    GLOBAL marks, round, report, starts, unplaced;

    # extract current round from marks for readability
    LET final_marks = SELECT start, round_element AS dance, adjudicator, value FROM marks 
                        WHERE marks.round = round;

    # evaluate all dances
    FOR dance IN dances: CALL evaluate_dance_final(dance);

    # compute places sum over dances and add to report
    LET places_sums = SELECT start, round, "places_sum" AS key, SUM(value) AS value, 
                            "R9a: sum of places over {ROWS(dances)} dances" AS reason FROM report
                        WHERE report.round = round AND round_element IS NOT NULL AND key = "place_val"
                        GROUP BY start;
    # report global sum column
    INSERT INTO report VALUES places_sums;

    LET unplaced = starts; # was already used by dance evaluations
    WHILE ROWS(unplaced):
    
        LET for_place  = ROWS(starts) - ROWS(unplaced) + 1; # next place to assign
        LET scores = SELECT start, value AS sum FROM places_sums WHERE start IN unplaced 
                                ORDER BY sum ASC LIMIT 1 ON DISTINCT sum;

        # try to resolve on sum only
        IF ROWS(scores) = 1:
            CALL assign_place(scores.start, NULL AS dance, for_place,
                              "R9a: lowest sum {scores.sum} of places over {ROWS(dances)} dances");
        ELSE IF ROWS(scores) > 1 AND NOT do_skating:
            CALL assign_place(scores.start, NULL AS dance, for_place,
                              "R9b, skating off: shared lowest sum {scores[1].sum}"
                              " of places over {ROWS(dances)} dances");
        # relay to skating
        ELSE IF ROWS(scores) > 1:
            CALL perform_skating(final_marks, scores, for_place);
        # cannot/should not/will not happen, but would deadlock
        ELSE: ABORT "internal error: <scores> empty";
# evaluate_round_final_skating()


# Apply skating rules 10, 11 to given tie group.
FUNCTION perform_skating(marks,         # table (start, dance, adjudicator, value) with relevant marks
                         scores,        # table (start, sum) with starts and place sum to consider for skating
                         for_place):    # place to be assigned next
    GLOBAL round, report;

    # report r10 application
    LET apply_r10 = SELECT start, round AS round, "R10-applied" AS group, for_place AS subgroup, "X" AS value,
                           "R9b: sum {scores[1].sum} tie on place {for_place}" AS reason FROM scores;
    INSERT INTO report VALUES apply_r10;
    # fetch counts and sums better or equal target place
    LET scores = SELECT start, COUNT(value) AS num, SUM(value) AS sum FROM report
                        WHERE report.round = round AND round_element IS NOT NULL AND key = "place_val" 
                                AND value <= for_place AND start IN scores.start
                        GROUP BY start;
 
    # report counts considered
    CALL report_count(scores, NULL AS dance, "R10-criteria" AS group, by_place, "R10a,b for place {for_place}");
    # fetch best-count occurrences among candidates
    LET scores = SELECT * FROM scores ORDER BY num DESC LIMIT 1 ON DISTINCT num;
    # try to resolve on count
    IF ROWS(scores) = 1:
        RETURN assign_place(scores.start, NULL AS dance, for_place,
                            "R10a,b: highest count {scores.num} on place {for_place}");

    # report sums considered
    CALL report_sum(scores, NULL AS dance, "R10-criteria" AS group, by_place, "R10c,d for place {for_place}");
    # fetch best-sum occurrences among candidates
    LET scores = SELECT * FROM scores ORDER BY sum ASC LIMIT 1 ON DISTINCT sum;
    # try to resolve on sum
    IF ROWS(scores) = 1:
        RETURN assign_place(scores.start, NULL AS dance, for_place,
                            "R10c,d: lowest sum {scores.sum} on place {for_place}");

    # report r11 application
    LET apply_r11 = SELECT start, round AS round, "R11-applied" AS group, for_place AS subgroup, "X" AS value, 
                           "R10e: sum {scores[1].sum} tie on place {for_place}" AS reason FROM scores;
    INSERT INTO report VALUES apply_r11;
    # invoke rules 5 to 8, taking TSO Appendix 2 sort of literally
    CALL refine_counts_and_sums(marks, scores.start, NULL AS dance, for_place AS min_by_place);
# perform_skating()


# ================================== Helpers ==================================


# Process a single or shared place assigment for a dance *or* round 
FUNCTION assign_place(starts,       # table (start) to process, subset of <unplaced>
                      dance,        # dance id -- if NULL, treat as round place assignment via R11
                      place_min,    # start value of assigned place range 
                      reason):      # textual description of assignment rationale
    GLOBAL report, round, unplaced;
    # compute end of place range
    LET place_max = place_min + ROWS(starts) - 1;
    # drop starts we just assigned
    LET unplaced = SELECT * FROM unplaced WHERE unplaced.start NOT IN starts;
    # extend reason for R11 application
    IF dance IS NULL: LET reason = "R11, {reason}";
    # add placings to report
    FOR start IN starts:
        INSERT INTO report VALUES ROW(start, round, dance AS round_element, 'place_min' AS key, place_min AS value, reason);
        INSERT INTO report VALUES ROW(start, round, dance AS round_element, 'place_max' AS key, place_max AS value, reason);
        # only for dance evaluation, we also need a place value for aggregation
        IF dance IS NOT NULL:
            INSERT INTO report VALUES 
                ROW(start, round, dance AS round_element, 'place_val' AS key, (place_min + place_max) / 2 AS value, 
                    IF(place_min = place_max, NULL, "R7d: average of {place-min}..{place_max}") AS reason);
# assign_place()


# Report count attributes for rules using count fields.
FUNCTION report_count(scores,            # table (start, num, sum) to report values from
                      dance = NULL,      # optional dance id
                      group = NULL,      # optional group header, intended for skating rules
                      place,             # place the attribute belongs to
                      reason = NULL):    # textual description of entry
    GLOBAL report, round;
    FOR s IN scores.start:
        row = ROW(s.start, round, dance AS round_element, group, place AS subgroup, 'count' AS key, s.num AS value, reason);
        # we must "manually" check if entry already exists (no suitable indexing)
        IF NOT SELECT COUNT(*) FROM report WHERE VALUES MATCH row:
            INSERT INTO report VALUES row;
# report_count()


# Report sum attributes for rules using sum fields.
FUNCTION report_sum(  scores,            # table (start, num, sum) to report values from
                      dance = NULL,      # optional dance id
                      group = NULL,      # optional group header, intended for skating rules
                      place,             # place the attribute belongs to
                      reason = NULL):    # textual description of entry
    GLOBAL report, round;
    FOR s IN scores.start:
        row = ROW(s.start, round, dance AS round_element, group, place AS subgroup, 'sum' AS key, c.sum AS value, reason);
        # we must "manually" check if entry already exists (no suitable indexing)
        IF NOT SELECT COUNT(*) FROM report WHERE VALUES MATCH row:
            INSERT INTO report VALUES row;
# report_sum()