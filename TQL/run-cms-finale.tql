IMPORT 'cross-majority-skating.tql';

# only for testing purposes, set up interface tables
# (in TAS integration, these should be set up by the framework)
IF FALSE:
    CALL prepare_interface_input();
    LOAD TABLE FROM 'test-data/cms-elimination-marks.csv' INTO marks;
IF TRUE:
    CALL prepare_interface_output();
    GLOBAL round = NULL;

# perform evaluation
CALL evaluate_round_final(TRUE AS do_skating);

# only for testing purpose, dump report
IF FALSE:
    SAVE TABLE report INTO 'test-data/cms-finale-report.csv';